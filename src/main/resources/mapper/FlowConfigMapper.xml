<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
		"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.aiworkflowback.Flow.Mapper.FlowConfigMapper">
	<insert id="insertValue">
		INSERT INTO flow_config (
			flowConfigId,
			nodeList,
			edgeList,
			createTime,
			updateTime
		) VALUE (
			#{flowConfigId},
			#{nodeList},
			#{edgeList},
			#{createTime},
			#{updateTime}
		)
	</insert>
	<select id="selectByFlowConfigId" resultType="com.example.aiworkflowback.Flow.Modal.Entity.FlowConfigEntity">
		SELECT * FROM flow_config WHERE flowConfigId = #{flowConfigId}
	</select>
	
</mapper>