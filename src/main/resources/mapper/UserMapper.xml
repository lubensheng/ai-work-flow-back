<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.aiworkflowback.User.Mapper.UserMapper">
    <select
        id="selectUserByUserName"
        resultType="com.example.aiworkflowback.User.Model.Entity.UserEntity"
    >
        select * from user_table where userName = #{userName}
    </select>
    <insert id="insertUserInfo">
        INSERT INTO user_table (
            userName,
            password
        ) VALUES (
            #{userName},
            #{password}
        )
    </insert>
    <update id="updateUserInfo">
        UPDATE user_table SET password=#{password} WHERE userName=#{userName}
    </update>
</mapper>